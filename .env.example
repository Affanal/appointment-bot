# Telegram Notification Settings
# Create a bot via @BotFather on Telegram and get the token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# TLS Contact Settings
# Application centre city codes: LON (London), MAN (Manchester), EDI (Edinburgh), BIR (Birmingham)
TLS_CITY=LON
# Check interval in seconds (default: 300 = 5 minutes)
CHECK_INTERVAL=300

# Optional: Email Notification Settings (leave empty to disable)
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
